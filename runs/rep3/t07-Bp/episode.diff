diff --git a/tally/utils.py b/tally/utils.py
index e2cfa15..6bf06a5 100644
--- a/tally/utils.py
+++ b/tally/utils.py
@@ -28,6 +28,19 @@ def month_key(d):
     return "{:04d}-{:02d}".format(d.year, d.month)
 
 
+def week_key(d):
+    """Return the ISO week key 'YYYY-WNN' for a date (weeks start Monday).
+
+    Uses ISO 8601 calendar so Monday is always the first day of every week.
+    Contrast with strftime('%W') which counts from Sunday and gives wrong
+    groupings for Mon-start weeks.
+    """
+    if isinstance(d, str):
+        d = parse_date(d)
+    iso_year, iso_week, _ = d.isocalendar()
+    return "{:04d}-W{:02d}".format(iso_year, iso_week)
+
+
