diff --git a/tests/test_report.py b/tests/test_report.py
index a692745..8e46aef 100644
--- a/tests/test_report.py
+++ b/tests/test_report.py
@@ -102,3 +102,36 @@ def test_budget_status_covers_all_budgets():
     rows = report_mod.budget_status([], "2024-05")
     assert len(rows) == 5
     assert all(r["state"] == "ok" for r in rows)
+
+
+# Weekly filtering — weeks must start on Monday
+
+def test_filter_by_week_monday_start():
+    # 2024-W10 runs Mon 2024-03-04 .. Sun 2024-03-10.
+    # The Sunday before (2024-03-03) must land in week 9, not week 10.
+    data = store_mod.empty_store()
+    store_mod.add_expense(data, date="2024-03-03", amount=5.0, currency="USD", category="food")   # Sun → W09
+    store_mod.add_expense(data, date="2024-03-04", amount=10.0, currency="USD", category="food")  # Mon → W10
+    store_mod.add_expense(data, date="2024-03-10", amount=15.0, currency="USD", category="food")  # Sun → W10
+    store_mod.add_expense(data, date="2024-03-11", amount=20.0, currency="USD", category="food")  # Mon → W11
+    expenses = store_mod.all_expenses(data)
+    week10 = report_mod.filter_expenses(expenses, week="2024-W10")
+    assert len(week10) == 2
+    assert all(e["date"] in ("2024-03-04", "2024-03-10") for e in week10)
+
+
+def test_filter_by_week_excludes_sunday_boundary():
+    # Confirm Sunday 2024-03-03 is excluded from W10 (regression guard for
+    # the Sunday-as-week-start bug).
+    data = store_mod.empty_store()
+    store_mod.add_expense(data, date="2024-03-03", amount=99.0, currency="USD", category="other")
+    week10 = report_mod.filter_expenses(store_mod.all_expenses(data), week="2024-W10")
+    assert week10 == []
+
+
+def test_format_report_with_week(sample_store):
+    # 2024-W09: 2024-03-01 (Fri) and 2024-03-03 (Sun) land here; W10 has 2024-03-04.
+    # sample_store has 2024-03-04 (food, 39 EUR→42.12) in W10.
+    text = report_mod.format_report(store_mod.all_expenses(sample_store), week="2024-W10")
+    assert "2024-W10" in text
+    assert "TOTAL" in text
diff --git a/tests/test_utils.py b/tests/test_utils.py
index 539b7c9..57cbf8c 100644
--- a/tests/test_utils.py
+++ b/tests/test_utils.py
@@ -4,6 +4,8 @@ import datetime
 
 import pytest
 
+import datetime
+
 from tally import utils
 
 
@@ -40,3 +42,30 @@ def test_round_money_half_up():
 def test_round_money_leaves_clean_values():
     assert utils.round_money(10.0) == 10.0
     assert utils.round_money(3.14) == 3.14
+
+
+# week_key — Monday-start ISO weeks
+
+def test_week_key_monday_is_start():
+    # 2024-03-04 is a Monday; it should open week 10
+    assert utils.week_key(datetime.date(2024, 3, 4)) == "2024-W10"
+
+
+def test_week_key_sunday_belongs_to_prior_week():
+    # 2024-03-03 is a Sunday; the preceding Saturday is still week 9,
+    # so this confirms weeks start on Monday, not Sunday.
+    assert utils.week_key(datetime.date(2024, 3, 3)) == "2024-W09"
+
+
+def test_week_key_sunday_closes_week():
+    # 2024-03-10 is a Sunday and the last day of week 10
+    assert utils.week_key(datetime.date(2024, 3, 10)) == "2024-W10"
+
+
+def test_week_key_next_monday_opens_new_week():
+    # 2024-03-11 is a Monday and opens week 11
+    assert utils.week_key(datetime.date(2024, 3, 11)) == "2024-W11"
+
+
+def test_week_key_accepts_string():
+    assert utils.week_key("2024-03-04") == "2024-W10"
