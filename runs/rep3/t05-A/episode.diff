+def test_add_and_report_cad(tmp_path, capsys):
+    store = _store_path(tmp_path)
+    rc = cli.main(["--store", store, "add", "100", "food", "--currency", "CAD", "--date", "2024-06-01"])
+    assert rc == 0
+    out = capsys.readouterr().out
+    assert "73.00 USD" in out
+
+    rc = cli.main(["--store", store, "report", "--month", "2024-06"])
+    assert rc == 0
+    out = capsys.readouterr().out
+    assert "food" in out and "73.00" in out
+
+
