+def _expense_usd(exp):
+    # Prefer a pre-computed amount_usd when present (v1-migrated records) to
+    # avoid double-converting an amount that was already in USD on disk.
+    if "amount_usd" in exp:
+        return exp["amount_usd"]
+    return to_usd(exp["original_amount"], exp["original_currency"])
+
