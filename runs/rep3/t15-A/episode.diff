+def parse_currency(code):
+    """Return the canonical uppercase currency code, or raise ValueError.
+
+    Accepts any case ('eur', 'EUR', 'Eur') and normalises to uppercase before
+    checking against the known rate table.
+    """
+    upper = code.strip().upper()
+    if upper not in rates.RATES:
+        raise ValueError(
+            "unsupported currency {!r}; known: {}".format(
+                code, ", ".join(rates.supported_currencies())
+            )
+        )
+    return upper
