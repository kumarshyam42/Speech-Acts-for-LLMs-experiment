diff --git a/tests/test_cli.py b/tests/test_cli.py
index 7611c18..9e5ac2b 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -74,6 +74,30 @@ def test_list_command(tmp_path, capsys):
     assert "dinner" in out and "food" in out
 
 
+def test_report_year(tmp_path, capsys):
+    store = _store_path(tmp_path)
+    cli.main(["--store", store, "add", "50", "food", "--date", "2024-03-15"])
+    cli.main(["--store", store, "add", "30", "transport", "--date", "2024-07-01"])
+    capsys.readouterr()
+    rc = cli.main(["--store", store, "report", "--year", "2024"])
+    assert rc == 0
+    out = capsys.readouterr().out
+    assert "Report for 2024" in out
+    assert "food" in out
+    assert "transport" in out
+    assert "TOTAL" in out
+
+
+def test_report_year_no_match(tmp_path, capsys):
+    store = _store_path(tmp_path)
+    cli.main(["--store", store, "add", "50", "food", "--date", "2024-03-15"])
+    capsys.readouterr()
+    rc = cli.main(["--store", store, "report", "--year", "2025"])
+    assert rc == 0
+    out = capsys.readouterr().out
+    assert "(no expenses)" in out
+
+
 def test_no_command_prints_help(capsys):
     rc = cli.main([])
     assert rc == 1
diff --git a/tests/test_report.py b/tests/test_report.py
