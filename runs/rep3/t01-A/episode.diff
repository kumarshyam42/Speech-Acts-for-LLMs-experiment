+
+
+def test_year_summary_2024(sample_store):
+    # All 6 sample expenses are in 2024; annual total matches grand total.
+    summary = report_mod.year_summary(store_mod.all_expenses(sample_store), 2024)
+    assert round(sum(summary.values()), 2) == EXPECTED_GRAND_TOTAL
+
+
+def test_year_summary_empty_year(sample_store):
+    summary = report_mod.year_summary(store_mod.all_expenses(sample_store), 2025)
+    assert summary == {}
+
+
+def test_filter_expenses_by_year(sample_store):
+    rows_2024 = report_mod.filter_expenses(store_mod.all_expenses(sample_store), year=2024)
+    assert len(rows_2024) == 6
+    rows_2025 = report_mod.filter_expenses(store_mod.all_expenses(sample_store), year=2025)
+    assert len(rows_2025) == 0
+
+
+def test_format_report_year(sample_store):
+    text = report_mod.format_report(store_mod.all_expenses(sample_store), year=2024)
+    assert "Report for 2024" in text
+    assert "TOTAL" in text
+    assert "USD" in text
+    assert "(no expenses)" not in text
+
+
+def test_format_report_year_empty(sample_store):
