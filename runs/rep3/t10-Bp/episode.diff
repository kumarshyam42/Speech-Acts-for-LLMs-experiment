@@ -10,6 +10,8 @@ The default store lives at ./tally.json; override it with --store.
 """
 
 import argparse
+import json
+import re
 import sys
 
 from tally import report as report_mod
@@ -17,6 +19,14 @@ from tally import store as store_mod
 from tally.config import DEFAULT_CURRENCY
 from tally.utils import month_key, parse_date
 
+_MONTH_RE = re.compile(r"^\d{4}-\d{2}$")
+
+
+def _validate_month(month):
+    """Raise ValueError if month is not YYYY-MM."""
+    if month is not None and not _MONTH_RE.match(month):
+        raise ValueError("invalid month {!r}; use YYYY-MM".format(month))
+
 DEFAULT_STORE = "tally.json"
 
 
@@ -25,6 +35,8 @@ def _load(args):
 
 
 def cmd_add(args):
+    if args.amount <= 0:
+        raise ValueError("amount must be positive, got {}".format(args.amount))
     data = _load(args)
     # normalize the date so we fail early on a bad value
     date = parse_date(args.date).isoformat()
@@ -44,6 +56,7 @@ def cmd_add(args):
 
 
 def cmd_report(args):
+    _validate_month(args.month)
     data = _load(args)
     text = report_mod.format_report(
         store_mod.all_expenses(data), month=args.month, category=args.category
@@ -53,6 +66,7 @@ def cmd_report(args):
 
 
 def cmd_list(args):
+    _validate_month(args.month)
     data = _load(args)
     rows = report_mod.filter_expenses(
         store_mod.all_expenses(data), month=args.month, category=args.category
@@ -87,6 +101,7 @@ def cmd_stats(args):
 
 
 def cmd_budget(args):
+    _validate_month(args.month)
     data = _load(args)
     rows = report_mod.budget_status(store_mod.all_expenses(data), month=args.month)
     print("Budget for {}".format(args.month))
@@ -144,7 +159,14 @@ def main(argv=None):
         import datetime
 
         args.date = datetime.date.today().isoformat()
-    return args.func(args)
+    try:
+        return args.func(args)
+    except (ValueError, OSError) as exc:
+        print("error: {}".format(exc), file=sys.stderr)
+        return 1
+    except json.JSONDecodeError as exc:
+        print("error: store file is not valid JSON: {}".format(exc), file=sys.stderr)
+        return 1
 
 
 if __name__ == "__main__":
