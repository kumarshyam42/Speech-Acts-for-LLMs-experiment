+def test_report_week_filter(tmp_path, capsys):
+    store = _store_path(tmp_path)
+    # 2024-03-04 is Monday of W10; 2024-03-11 is Monday of W11
+    cli.main(["--store", store, "add", "50", "food", "--date", "2024-03-04"])
+    cli.main(["--store", store, "add", "30", "transport", "--date", "2024-03-11"])
+    capsys.readouterr()
+    cli.main(["--store", store, "report", "--week", "2024-W10"])
+    out = capsys.readouterr().out
+    assert "food" in out
+    assert "transport" not in out
+    assert "2024-W10" in out
+
+
+def test_report_week_sunday_same_week_as_monday(tmp_path, capsys):
+    store = _store_path(tmp_path)
+    # Both Monday 2024-03-04 and Sunday 2024-03-10 are in W10
+    cli.main(["--store", store, "add", "50", "food", "--date", "2024-03-04"])
+    cli.main(["--store", store, "add", "20", "food", "--date", "2024-03-10"])
+    capsys.readouterr()
+    cli.main(["--store", store, "report", "--week", "2024-W10"])
+    out = capsys.readouterr().out
+    assert "70.00" in out
+
