diff --git a/tests/test_utils.py b/tests/test_utils.py
index 539b7c9..2c3afef 100644
--- a/tests/test_utils.py
+++ b/tests/test_utils.py
@@ -28,6 +28,36 @@ def test_month_key_from_date():
     assert utils.month_key(datetime.date(2024, 3, 4)) == "2024-03"
 
 
+def test_week_key_basic():
+    # 2024-03-04 is a Monday and falls in ISO week 10 of 2024
+    assert utils.week_key(datetime.date(2024, 3, 4)) == "2024-W10"
+
+
+def test_week_key_from_string():
+    assert utils.week_key("2024-03-04") == "2024-W10"
+
+
+def test_week_key_monday_start():
+    # 2024-03-04 (Mon) and 2024-03-10 (Sun) must be the SAME week
+    monday = datetime.date(2024, 3, 4)
+    sunday = datetime.date(2024, 3, 10)
+    assert utils.week_key(monday) == utils.week_key(sunday)
+
+
+def test_week_key_sunday_not_in_next_week():
+    # Sunday (2024-03-10) must stay in the same week as Monday (2024-03-04),
+    # not spill into the following week as it would under a Sunday-start scheme.
+    sunday = datetime.date(2024, 3, 10)
+    next_monday = datetime.date(2024, 3, 11)
+    assert utils.week_key(sunday) != utils.week_key(next_monday)
+
+
+def test_week_key_week_boundary():
+    # 2024-03-10 (Sun, end of W10) and 2024-03-11 (Mon, start of W11) are different weeks
+    assert utils.week_key(datetime.date(2024, 3, 10)) == "2024-W10"
+    assert utils.week_key(datetime.date(2024, 3, 11)) == "2024-W11"
+
+
