+def parse_currency(code):
+    """Validate and normalise a currency code, returning it in uppercase.
+
+    Case-insensitive: 'eur' and 'EUR' both return 'EUR'. Raises ValueError
+    for codes not in the conversion table.
+    """
+    upper = code.strip().upper()
+    if upper not in RATES:
+        raise ValueError(
+            "unsupported currency {!r}; known: {}".format(code, ", ".join(supported_currencies()))
+        )
+    return upper
+
