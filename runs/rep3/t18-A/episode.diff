+def _category_stats(expenses):
+    """Return {category: {total, count}} over the given expenses."""
+    stats = {}
+    for exp in expenses:
+        cat = exp["category"]
+        if cat not in stats:
+            stats[cat] = {"total": 0.0, "count": 0}
+        stats[cat]["total"] = round_money(stats[cat]["total"] + exp["amount_usd"])
+        stats[cat]["count"] += 1
+    return stats
+
+
 def grand_total(expenses):
     """Return the total USD across the given expenses."""
     return round_money(sum(exp["amount_usd"] for exp in expenses))
