@@ -88,3 +88,32 @@ def test_add_defaults_currency_to_usd(tmp_path, capsys):
         data = json.load(fh)
     assert data["expenses"][0]["original_currency"] == "USD"
     assert data["expenses"][0]["amount_usd"] == 12.5
+
