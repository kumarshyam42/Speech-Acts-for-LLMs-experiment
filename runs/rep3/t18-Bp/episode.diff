+    """Render a plain-text report of category totals to a string.
+
+    Each category line shows the USD total plus:
+      - item count
+      - share of the grand total (omitted when filtered to one category)
+      - budget utilisation (only when a month filter is active without a
+        category filter, because budgets are monthly and per-category)
+    """
     selected = filter_expenses(expenses, month=month, category=category)
     totals = category_totals(selected)
+
+    counts = {}
+    for exp in selected:
+        cat = exp["category"]
+        counts[cat] = counts.get(cat, 0) + 1
+
+    # Budget context is only meaningful for a whole-month view
+    budgets = {}
+    if month and not category:
+        for row in budget_status(selected, month):
+            budgets[row["category"]] = row
+
     lines = []
     header = "Report"
     if month:
@@ -60,9 +79,23 @@ def format_report(expenses, month=None, category=None):
     if not totals:
         lines.append("(no expenses)")
     else:
+        gt = grand_total(selected)
         for cat in sorted(totals):
-            lines.append("{:<14} {:>10.2f} USD".format(cat, totals[cat]))
-        lines.append("{:<14} {:>10.2f} USD".format("TOTAL", grand_total(selected)))
+            amt = totals[cat]
+            n = counts.get(cat, 0)
+            item_word = "item" if n == 1 else "items"
+            parts = ["{:<14} {:>10.2f} USD".format(cat, amt)]
+            parts.append("  ({} {})".format(n, item_word))
+            if not category:
+                pct = (amt / gt * 100) if gt else 0.0
+                parts.append("  {:.0f}% of total".format(pct))
+            if cat in budgets:
+                b = budgets[cat]
+                parts.append("  [{:.0f}% of ${:.0f} budget, {}]".format(
+                    b["ratio"] * 100, b["budget"], b["state"]
+                ))
+            lines.append("".join(parts))
+        lines.append("{:<14} {:>10.2f} USD".format("TOTAL", gt))
     return "\n".join(lines)
 
 
diff --git a/tests/test_report.py b/tests/test_report.py
index a692745..1166a96 100644
--- a/tests/test_report.py
