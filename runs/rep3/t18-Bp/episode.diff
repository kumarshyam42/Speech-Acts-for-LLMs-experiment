@@ -47,6 +47,41 @@ def test_format_report_contains_total(sample_store):
     assert "USD" in text
 
 
+def test_format_report_shows_item_count(sample_store):
+    # food has 2 expenses in March; rent and entertainment each have 1
+    text = report_mod.format_report(store_mod.all_expenses(sample_store), month="2024-03")
+    assert "2 items" in text   # food
+    assert "1 item" in text    # rent or entertainment (singular)
+
+
+def test_format_report_shows_pct_of_total(sample_store):
+    # With only one expense category total, % of total annotation must appear
+    text = report_mod.format_report(store_mod.all_expenses(sample_store), month="2024-03")
+    assert "% of total" in text
+
+
+def test_format_report_shows_budget_info(sample_store):
+    # A month-filtered report without a category filter must include budget lines
+    text = report_mod.format_report(store_mod.all_expenses(sample_store), month="2024-03")
+    assert "budget" in text
+    assert "ok" in text  # all March categories are well under budget
+
+
+def test_format_report_no_budget_info_when_no_month(sample_store):
+    # Without a month filter, budget context is not shown
+    text = report_mod.format_report(store_mod.all_expenses(sample_store))
+    assert "budget" not in text
+
+
+def test_format_report_no_budget_info_when_category_filter(sample_store):
+    # Category-filtered report omits budget and % of total (both meaningless here)
+    text = report_mod.format_report(
+        store_mod.all_expenses(sample_store), month="2024-03", category="food"
+    )
+    assert "budget" not in text
+    assert "% of total" not in text
+
+
 def test_format_report_empty():
     text = report_mod.format_report([], month="2024-01")
     assert "(no expenses)" in text
