+def parse_currency(code):
+    """Validate and normalise a currency code string.
+
+    Accepts mixed-case input (e.g. 'eur', 'Eur') and returns the canonical
+    upper-case code.  Raises ValueError for unknown codes.
+    """
+    from tally.rates import RATES, supported_currencies  # local import avoids circular dep
+
+    upper = code.strip().upper()
+    if upper not in RATES:
+        raise ValueError(
+            "unsupported currency {!r}; known: {}".format(
+                code, ", ".join(supported_currencies())
+            )
+        )
+    return upper
+
