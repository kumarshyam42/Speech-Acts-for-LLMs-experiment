diff --git a/tests/test_report.py b/tests/test_report.py
index a692745..0ace54a 100644
--- a/tests/test_report.py
+++ b/tests/test_report.py
@@ -102,3 +102,37 @@ def test_budget_status_covers_all_budgets():
     rows = report_mod.budget_status([], "2024-05")
     assert len(rows) == 5
     assert all(r["state"] == "ok" for r in rows)
+
+
+# --- category_stats and enriched format_report ---
+
+def test_category_stats_count_and_total(sample_store):
+    stats = report_mod.category_stats(store_mod.all_expenses(sample_store))
+    assert stats["food"]["count"] == 2
+    assert stats["food"]["total"] == EXPECTED_MARCH_FOOD
+
+
+def test_format_report_shows_count(sample_store):
+    text = report_mod.format_report(store_mod.all_expenses(sample_store), month="2024-03")
+    # food has 2 expenses in March; its line must contain "2"
+    food_line = next(l for l in text.splitlines() if l.startswith("food"))
+    assert "2" in food_line
+
+
+def test_format_report_shows_percentage(sample_store):
+    text = report_mod.format_report(store_mod.all_expenses(sample_store), month="2024-03")
+    # TOTAL row always shows 100.0%
+    assert "100.0%" in text
+
+
+def test_format_report_shows_budget_when_month_given(sample_store):
+    text = report_mod.format_report(store_mod.all_expenses(sample_store), month="2024-03")
+    # food budget is 600.00; state must be "ok" for March spending
+    assert "600.00" in text
+    assert "[ok]" in text
+
+
+def test_format_report_no_budget_without_month(sample_store):
+    text = report_mod.format_report(store_mod.all_expenses(sample_store))
+    # no month filter → no budget columns
+    assert "budget" not in text
