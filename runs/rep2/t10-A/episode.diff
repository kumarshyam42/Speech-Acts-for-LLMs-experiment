+def _validate_month(month):
+    """Raise ValueError if month is not None and not in YYYY-MM format."""
+    if month is not None:
+        try:
+            parse_date(month)
+        except ValueError:
+            raise ValueError("month must be YYYY-MM, got {!r}".format(month))
+
+
 def cmd_add(args):
+    if args.amount <= 0:
+        raise ValueError("amount must be positive, got {!r}".format(args.amount))
+    if args.category not in KNOWN_CATEGORIES:
+        raise ValueError(
+            "unknown category {!r}; known: {}".format(args.category, ", ".join(KNOWN_CATEGORIES))
+        )
     data = _load(args)
     # normalize the date so we fail early on a bad value
     date = parse_date(args.date).isoformat()
