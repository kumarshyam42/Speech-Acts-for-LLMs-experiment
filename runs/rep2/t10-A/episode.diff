+def test_add_invalid_date(tmp_path, capsys):
+    store = _store_path(tmp_path)
+    rc = cli.main(["--store", store, "add", "10", "food", "--date", "not-a-date"])
+    assert rc == 1
+    assert "error:" in capsys.readouterr().err
+
+
