-        lines.append("{:<14} {:>10.2f} USD".format("TOTAL", grand_total(selected)))
+        total_items = sum(v["count"] for v in breakdown.values())
+        for cat in sorted(breakdown):
+            entry = breakdown[cat]
+            pct = (entry["total_usd"] / total * 100) if total else 0.0
+            item_word = "item " if entry["count"] == 1 else "items"
