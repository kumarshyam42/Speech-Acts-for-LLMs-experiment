@@ -35,6 +35,17 @@ def category_totals(expenses):
     return totals
 
 
+def category_breakdown(expenses):
+    """Return {category: {total_usd, count}} over the given expenses."""
+    breakdown = {}
+    for exp in expenses:
+        cat = exp["category"]
+        entry = breakdown.setdefault(cat, {"total_usd": 0.0, "count": 0})
+        entry["total_usd"] = round_money(entry["total_usd"] + exp["amount_usd"])
+        entry["count"] += 1
+    return breakdown
+
+
 def grand_total(expenses):
     """Return the total USD across the given expenses."""
     return round_money(sum(exp["amount_usd"] for exp in expenses))
