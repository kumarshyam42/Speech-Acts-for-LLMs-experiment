+def test_filter_by_week(sample_store):
+    # 2024-03-04 (groceries/food) is the only expense in W10.
+    w10 = report_mod.filter_expenses(store_mod.all_expenses(sample_store), week="2024-W10")
+    assert len(w10) == 1
+    assert w10[0]["note"] == "groceries"
+
+
+def test_filter_by_week_excludes_sunday_of_prev_week(sample_store):
+    # 2024-03-01 is a Friday in W09; it must NOT appear in W10.
+    w10 = report_mod.filter_expenses(store_mod.all_expenses(sample_store), week="2024-W10")
+    dates = [e["date"] for e in w10]
+    assert "2024-03-01" not in dates
+
+
+def test_format_report_weekly(sample_store):
+    text = report_mod.format_report(store_mod.all_expenses(sample_store), week="2024-W10")
+    assert "2024-W10" in text
+    assert "food" in text
+    assert "TOTAL" in text
diff --git a/tests/test_utils.py b/tests/test_utils.py
