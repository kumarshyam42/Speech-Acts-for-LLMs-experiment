+def test_week_key_monday_is_start_of_week():
+    # 2024-03-04 is a Monday — it must be in week W10, not the previous week.
+    assert utils.week_key(datetime.date(2024, 3, 4)) == "2024-W10"
+
+
+def test_week_key_sunday_is_end_of_week():
+    # 2024-03-10 is a Sunday — it must still be in week W10 (Mon–Sun).
+    assert utils.week_key(datetime.date(2024, 3, 10)) == "2024-W10"
+
+
+def test_week_key_from_string():
+    assert utils.week_key("2024-03-04") == "2024-W10"
+
+
+def test_week_key_iso_year_rollover():
+    # 2024-12-30 (Monday) is in ISO year 2025, week 1.
+    assert utils.week_key(datetime.date(2024, 12, 30)) == "2025-W01"
