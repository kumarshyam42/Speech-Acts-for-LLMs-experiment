@@ -28,6 +28,18 @@ def month_key(d):
     return "{:04d}-{:02d}".format(d.year, d.month)
 
 
+def week_key(d):
+    """Return the ISO week string (YYYY-WNN) for a date, weeks starting Monday.
+
+    Uses ISO 8601 week numbering, so weeks run Monday–Sunday and the ISO year
+    may differ from the calendar year near year boundaries.
+    """
+    if isinstance(d, str):
+        d = parse_date(d)
+    iso_year, iso_week, _ = d.isocalendar()
+    return "{:04d}-W{:02d}".format(iso_year, iso_week)
+
+
