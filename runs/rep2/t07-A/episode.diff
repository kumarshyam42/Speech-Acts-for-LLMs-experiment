+def test_week_key_monday_is_start():
+    # 2024-03-04 is a Monday — it starts ISO week 10.
+    assert utils.week_key(datetime.date(2024, 3, 4)) == "2024-W10"
+
+
+def test_week_key_sunday_still_same_week():
+    # 2024-03-10 is a Sunday — still part of ISO week 10 (Mon–Sun).
+    assert utils.week_key(datetime.date(2024, 3, 10)) == "2024-W10"
+
+
+def test_week_key_next_monday_is_new_week():
+    # 2024-03-11 is a Monday — the start of week 11.
+    assert utils.week_key(datetime.date(2024, 3, 11)) == "2024-W11"
+
+
+def test_week_key_year_boundary():
+    # 2024-12-30 is a Monday that opens ISO week 2025-W01.
+    assert utils.week_key(datetime.date(2024, 12, 30)) == "2025-W01"
+
+
+def test_week_key_accepts_string():
+    assert utils.week_key("2024-03-04") == "2024-W10"
+
+
