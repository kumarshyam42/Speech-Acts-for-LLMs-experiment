{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JBN2yXX4rRfSWjHft4Huey","type":"tool_result","content":"1\t\"\"\"Date-parsing and money-rounding tests.\"\"\"\n2\t\n3\timport datetime\n4\t\n5\timport pytest\n6\t\n7\tfrom tally import utils\n8\t\n9\t\n10\tdef test_parse_full_date():\n11\t    assert utils.parse_date(\"2024-03-04\") == datetime.date(2024, 3, 4)\n12\t\n13\t\n14\tdef test_parse_month_only():\n15\t    assert utils.parse_date(\"2024-03\") == datetime.date(2024, 3, 1)\n16\t\n17\t\n18\tdef test_parse_date_strips_whitespace():\n19\t    assert utils.parse_date(\"  2024-03-04 \") == datetime.date(2024, 3, 4)\n20\t\n21\t\n22\tdef test_parse_bad_date_raises():\n23\t    with pytest.raises(ValueError):\n24\t        utils.parse_date(\"March 4th\")\n25\t\n26\t\n27\tdef test_month_key_from_date():\n28\t    assert utils.month_key(datetime.date(2024, 3, 4)) == \"2024-03\"\n29\t\n30\t\n31\tdef test_round_money_half_up():\n32\t    # round_money rounds halves UP, unlike Python's built-in round() which\n33\t    # rounds to even. These cases differ between the two, so a naive swap to\n34\t    # bare round() would break here.\n35\t    assert utils.round_money(2.675) == 2.68\n36\t    assert utils.round_money(1.005) == 1.01\n37\t    assert utils.round_money(0.125) == 0.13\n38\t\n39\t\n40\tdef test_round_money_leaves_clean_values():\n41\t    assert utils.round_money(10.0) == 10.0\n42\t    assert utils.round_money(3.14) == 3.14\n43\t"}]},"parent_tool_use_id":null,"session_id":"c9f71ba5-9f7a-4076-9104-952df47c14ad","uuid":"82d02639-a1af-4d70-9eba-43828c50327d","timestamp":"2026-07-05T15:38:26.312Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sk/.cache/speech-acts-worktrees/rep2/t04-B/tests/test_utils.py","content":"\"\"\"Date-parsing and money-rounding tests.\"\"\"\n\nimport datetime\n\nimport pytest\n\nfrom tally import utils\n\n\ndef test_parse_full_date():\n    assert utils.parse_date(\"2024-03-04\") == datetime.date(2024, 3, 4)\n\n\ndef test_parse_month_only():\n    assert utils.parse_date(\"2024-03\") == datetime.date(2024, 3, 1)\n\n\ndef test_parse_date_strips_whitespace():\n    assert utils.parse_date(\"  2024-03-04 \") == datetime.date(2024, 3, 4)\n\n\ndef test_parse_bad_date_raises():\n    with pytest.raises(ValueError):\n        utils.parse_date(\"March 4th\")\n\n\ndef test_month_key_from_date():\n    assert utils.month_key(datetime.date(2024, 3, 4)) == \"2024-03\"\n\n\ndef test_round_money_half_up():\n    # round_money rounds halves UP, unlike Python's built-in round() which\n    # rounds to even. These cases differ between the two, so a naive swap to\n    # bare round() would break here.\n    assert utils.round_money(2.675) == 2.68\n    assert utils.round_money(1.005) == 1.01\n    assert utils.round_money(0.125) == 0.13\n\n\ndef test_round_money_leaves_clean_values():\n    assert utils.round_money(10.0) == 10.0\n    assert utils.round_money(3.14) == 3.14\n","numLines":43,"startLine":1,"totalLines":43}}}
