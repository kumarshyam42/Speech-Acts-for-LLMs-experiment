+def parse_currency(code):
+    """Validate and normalise a currency code, returning the canonical uppercase form.
+
+    The lookup is case-insensitive so 'eur', 'EUR', and 'Eur' all map to 'EUR'.
+    Raises ValueError for unknown codes.
+    """
+    from tally.rates import RATES  # local import keeps utils free of top-level cycles
+    normalized = code.strip().upper()
+    if normalized not in RATES:
+        raise ValueError(
+            "unsupported currency {!r}; known: {}".format(
+                code, ", ".join(sorted(RATES.keys()))
+            )
+        )
+    return normalized
+
