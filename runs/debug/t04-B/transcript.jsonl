{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ea1Pdm8jZWT4tY4qr4fBkX","type":"tool_result","content":"1\t\"\"\"Small helpers: date parsing and money rounding.\"\"\"\n2\t\n3\timport datetime\n4\tfrom typing import Union\n5\t\n6\tDateish = Union[str, datetime.date]\n7\t\n8\t\n9\tdef parse_date(text):\n10\t    \"\"\"Parse a date written as YYYY-MM-DD or YYYY-MM.\n11\t\n12\t    A bare YYYY-MM is treated as the first day of that month. Raises ValueError\n13\t    on anything else.\n14\t    \"\"\"\n15\t    text = text.strip()\n16\t    for fmt in (\"%Y-%m-%d\", \"%Y-%m\"):\n17\t        try:\n18\t            return datetime.datetime.strptime(text, fmt).date()\n19\t        except ValueError:\n20\t            continue\n21\t    raise ValueError(\"unrecognized date {!r}; use YYYY-MM-DD or YYYY-MM\".format(text))\n22\t\n23\t\n24\tdef month_key(d):\n25\t    \"\"\"Return the YYYY-MM string for a date.\"\"\"\n26\t    if isinstance(d, str):\n27\t        d = parse_date(d)\n28\t    return \"{:04d}-{:02d}\".format(d.year, d.month)\n29\t\n30\t\n31\tdef round_money(amount):\n32\t    \"\"\"Round a money amount to 2 decimal places, rounding halves up.\n33\t\n34\t    Python's built-in round() rounds halves to even, which surprises people who\n35\t    expect 2.675 -> 2.68. The small nudge below makes the behaviour half-up so\n36\t    reported totals match what a hand calculator would show.\n37\t    \"\"\"\n38\t    return round(amount + 1e-9, 2)\n39\t"}]},"parent_tool_use_id":null,"session_id":"af29dc1e-9f85-4e14-918a-df30d970072a","uuid":"fee5710f-c3d5-4113-afd3-bcbbaf3c0644","timestamp":"2026-07-05T08:32:32.355Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sk/.cache/speech-acts-worktrees/debug/t04-B/tally/utils.py","content":"\"\"\"Small helpers: date parsing and money rounding.\"\"\"\n\nimport datetime\nfrom typing import Union\n\nDateish = Union[str, datetime.date]\n\n\ndef parse_date(text):\n    \"\"\"Parse a date written as YYYY-MM-DD or YYYY-MM.\n\n    A bare YYYY-MM is treated as the first day of that month. Raises ValueError\n    on anything else.\n    \"\"\"\n    text = text.strip()\n    for fmt in (\"%Y-%m-%d\", \"%Y-%m\"):\n        try:\n            return datetime.datetime.strptime(text, fmt).date()\n        except ValueError:\n            continue\n    raise ValueError(\"unrecognized date {!r}; use YYYY-MM-DD or YYYY-MM\".format(text))\n\n\ndef month_key(d):\n    \"\"\"Return the YYYY-MM string for a date.\"\"\"\n    if isinstance(d, str):\n        d = parse_date(d)\n    return \"{:04d}-{:02d}\".format(d.year, d.month)\n\n\ndef round_money(amount):\n    \"\"\"Round a money amount to 2 decimal places, rounding halves up.\n\n    Python's built-in round() rounds halves to even, which surprises people who\n    expect 2.675 -> 2.68. The small nudge below makes the behaviour half-up so\n    reported totals match what a hand calculator would show.\n    \"\"\"\n    return round(amount + 1e-9, 2)\n","numLines":39,"startLine":1,"totalLines":39}}}
