+def parse_currency(code):
+    """Validate and normalise a currency code, returning its uppercase form.
+
+    Accepts lowercase or mixed-case input (e.g. 'eur', 'Eur').  Raises
+    ValueError for codes not present in the RATES table.
+    """
+    normalised = code.strip().upper()
+    if normalised not in RATES:
+        raise ValueError(
+            "unsupported currency {!r}; known: {}".format(
+                code, ", ".join(supported_currencies())
+            )
+        )
+    return normalised
+
