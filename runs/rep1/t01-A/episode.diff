diff --git a/tests/test_cli.py b/tests/test_cli.py
index 7611c18..9a9c2bd 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -88,3 +88,23 @@ def test_add_defaults_currency_to_usd(tmp_path, capsys):
         data = json.load(fh)
     assert data["expenses"][0]["original_currency"] == "USD"
     assert data["expenses"][0]["amount_usd"] == 12.5
+
+
+def test_report_year(tmp_path, capsys):
+    store = _store_path(tmp_path)
+    cli.main(["--store", store, "add", "50", "food", "--date", "2024-03-15"])
+    cli.main(["--store", store, "add", "30", "transport", "--date", "2024-03-16"])
+    cli.main(["--store", store, "add", "20", "food", "--date", "2025-01-01"])
+    capsys.readouterr()
+
+    rc = cli.main(["--store", store, "report", "--year", "2024"])
+    assert rc == 0
+    out = capsys.readouterr().out
+
+    assert "2024" in out
+    assert "food" in out
+    assert "transport" in out
+    assert "TOTAL" in out
+    # Only 2024 expenses (50 + 30 = 80); the 2025 expense must not appear
+    total_line = next(l for l in out.splitlines() if "TOTAL" in l)
+    assert "80.00" in total_line
