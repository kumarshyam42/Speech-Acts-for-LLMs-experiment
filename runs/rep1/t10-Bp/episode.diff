 def _load(args):
     return store_mod.load(args.store)
 
 
+def _validate_month(month):
+    """Raise ValueError if month is not a valid YYYY-MM string."""
+    if not _MONTH_RE.match(month):
+        raise ValueError("invalid month {!r}; use YYYY-MM".format(month))
+    try:
+        parse_date(month)
+    except ValueError:
+        raise ValueError("invalid month {!r}; use YYYY-MM".format(month))
+
+
 def cmd_add(args):
