+# ---------------------------------------------------------------------------
+# Error-handling tests
+# ---------------------------------------------------------------------------
+
+def test_add_bad_date(tmp_path, capsys):
+    store = _store_path(tmp_path)
+    rc = cli.main(["--store", store, "add", "10", "food", "--date", "not-a-date"])
+    assert rc == 1
+    err = capsys.readouterr().err
+    assert "error:" in err
+
+
+def test_add_unknown_currency(tmp_path, capsys):
+    store = _store_path(tmp_path)
+    rc = cli.main(["--store", store, "add", "10", "food", "--currency", "XYZ", "--date", "2024-03-01"])
+    assert rc == 1
+    err = capsys.readouterr().err
+    assert "error:" in err and "XYZ" in err
+
+
+def test_add_negative_amount(tmp_path, capsys):
+    store = _store_path(tmp_path)
+    rc = cli.main(["--store", store, "add", "-5", "food", "--date", "2024-03-01"])
+    assert rc == 1
+    err = capsys.readouterr().err
+    assert "error:" in err
+
+
+def test_add_zero_amount(tmp_path, capsys):
+    store = _store_path(tmp_path)
+    rc = cli.main(["--store", store, "add", "0", "food", "--date", "2024-03-01"])
+    assert rc == 1
+    err = capsys.readouterr().err
+    assert "error:" in err
+
+
+def test_add_unknown_category(tmp_path, capsys):
+    store = _store_path(tmp_path)
+    rc = cli.main(["--store", store, "add", "10", "widgets", "--date", "2024-03-01"])
+    assert rc == 1
+    err = capsys.readouterr().err
+    assert "error:" in err and "widgets" in err
+
+
+def test_load_corrupt_store(tmp_path, capsys):
+    store = _store_path(tmp_path)
+    with open(store, "w") as fh:
+        fh.write("not json {{{")
+    rc = cli.main(["--store", store, "report"])
+    assert rc == 1
+    err = capsys.readouterr().err
+    assert "error:" in err
