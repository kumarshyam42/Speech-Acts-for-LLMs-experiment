--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -3,6 +3,8 @@
 import json
 import os
 
+import pytest
+
 from tally import cli
 
 
@@ -88,3 +90,67 @@ def test_add_defaults_currency_to_usd(tmp_path, capsys):
         data = json.load(fh)
     assert data["expenses"][0]["original_currency"] == "USD"
