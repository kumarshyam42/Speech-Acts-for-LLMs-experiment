diff --git a/tally/store.py b/tally/store.py
index 97c153c..34c06e8 100644
--- a/tally/store.py
+++ b/tally/store.py
@@ -98,5 +98,17 @@ def find_expense(data, expense_id):
     return None
 
 
+def delete_expense(data, expense_id):
+    """Remove the expense with `expense_id` from `data`.
+
+    Returns the removed record, or None if no matching expense exists.
+    `data` is mutated in place.
+    """
+    for i, exp in enumerate(data["expenses"]):
+        if exp.get("id") == expense_id:
+            return data["expenses"].pop(i)
+    return None
+
+
 def all_expenses(data):
     return list(data["expenses"])
