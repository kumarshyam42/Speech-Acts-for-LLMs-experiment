--- a/tally/utils.py
+++ b/tally/utils.py
@@ -28,6 +28,19 @@ def month_key(d):
     return "{:04d}-{:02d}".format(d.year, d.month)
 
 
+def week_key(d):
+    """Return the ISO year-week string (YYYY-Www) for a date.
+
+    ISO weeks start on Monday and end on Sunday, so e.g. 2024-03-10 (Sunday)
+    belongs to the same week as 2024-03-04 (Monday): both return "2024-W10".
+    Using strftime('%U') would give Sunday-based week numbers — do not use it.
+    """
+    if isinstance(d, str):
+        d = parse_date(d)
+    iso_year, iso_week, _ = d.isocalendar()
+    return "{:04d}-W{:02d}".format(iso_year, iso_week)
+
+
