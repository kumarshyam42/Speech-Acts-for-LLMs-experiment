+def test_week_key_monday_is_week_start():
+    # 2024-03-04 is a Monday; it opens ISO week 10.
+    assert utils.week_key(datetime.date(2024, 3, 4)) == "2024-W10"
+
+
+def test_week_key_sunday_in_same_week_as_preceding_monday():
+    # 2024-03-10 is a Sunday — it belongs to the same ISO week as 2024-03-04.
+    # A Sunday-based implementation would start a *new* week here, which is wrong.
+    assert utils.week_key(datetime.date(2024, 3, 10)) == "2024-W10"
