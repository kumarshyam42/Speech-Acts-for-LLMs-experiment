+def test_report_week_filter(tmp_path, capsys):
+    store = _store_path(tmp_path)
+    # 2024-03-04 is a Monday (ISO week 2024-W10); 2024-03-11 is the next Monday (W11).
+    cli.main(["--store", store, "add", "30", "food", "--date", "2024-03-04"])
+    cli.main(["--store", store, "add", "50", "food", "--date", "2024-03-11"])
+    capsys.readouterr()
+    rc = cli.main(["--store", store, "report", "--week", "2024-W10"])
+    assert rc == 0
+    out = capsys.readouterr().out
+    assert "2024-W10" in out
+    assert "30.00" in out
+    assert "50.00" not in out
+
+
+def test_report_week_sunday_not_bumped_to_next_week(tmp_path, capsys):
+    store = _store_path(tmp_path)
+    # 2024-03-10 is Sunday — belongs to W10, not W11.
+    cli.main(["--store", store, "add", "25", "food", "--date", "2024-03-10"])
+    capsys.readouterr()
+    rc = cli.main(["--store", store, "report", "--week", "2024-W10"])
+    assert rc == 0
+    out = capsys.readouterr().out
+    assert "25.00" in out
diff --git a/tests/test_report.py b/tests/test_report.py
index a692745..ddb7cdc 100644
--- a/tests/test_report.py
+++ b/tests/test_report.py
@@ -102,3 +102,42 @@ def test_budget_status_covers_all_budgets():
     rows = report_mod.budget_status([], "2024-05")
     assert len(rows) == 5
     assert all(r["state"] == "ok" for r in rows)
+
+
+def test_filter_by_week_returns_correct_expense(sample_store):
+    # 2024-03-04 (Monday) is in ISO week 2024-W10. Only the "groceries" food
+    # expense lands on that date; the filter must return exactly one record.
+    from tally import store as store_mod
+
+    week_rows = report_mod.filter_expenses(store_mod.all_expenses(sample_store), week="2024-W10")
+    assert len(week_rows) == 1
+    assert week_rows[0]["date"] == "2024-03-04"
+
+
+def test_filter_by_week_excludes_other_weeks(sample_store):
+    from tally import store as store_mod
+
+    week_rows = report_mod.filter_expenses(store_mod.all_expenses(sample_store), week="2024-W09")
+    # 2024-03-01 (Friday) is in W09; only the "room share" rent expense is there.
+    assert len(week_rows) == 1
+    assert week_rows[0]["date"] == "2024-03-01"
+
+
+def test_format_report_week_header(sample_store):
+    from tally import store as store_mod
+
+    text = report_mod.format_report(store_mod.all_expenses(sample_store), week="2024-W10")
+    assert "2024-W10" in text
+    assert "TOTAL" in text
+
+
+def test_sunday_belongs_to_preceding_monday_week():
+    # A Sunday-based implementation would put Sunday in the *next* week bucket,
+    # causing expenses logged on Sunday to disappear from the expected week.
+    from tally import store as store_mod
+
+    data = store_mod.empty_store()
+    store_mod.add_expense(data, date="2024-03-10", amount=10.0, currency="USD", category="food")
+    # 2024-03-10 is a Sunday; it must be in the same week as 2024-03-04 (Monday).
+    rows = report_mod.filter_expenses(store_mod.all_expenses(data), week="2024-W10")
+    assert len(rows) == 1, "Sunday expense should be in the Monday-anchored week 10"
