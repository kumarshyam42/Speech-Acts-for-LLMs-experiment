+def parse_currency(code):
+    """Normalise and validate a currency code.
+
+    Accepts any case (e.g. 'eur', 'Eur', 'EUR') and returns the canonical
+    three-letter ISO 4217 uppercase code.  Raises ValueError for unknown codes.
+    """
+    normalised = code.strip().upper()
+    if normalised not in _VALID_CURRENCIES:
+        raise ValueError("unknown currency code {!r}".format(code))
+    return normalised
+
