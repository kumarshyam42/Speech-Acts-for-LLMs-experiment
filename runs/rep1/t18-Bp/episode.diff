+def test_format_report_shows_transaction_counts(sample_store):
+    # March has food(2), entertainment(1), rent(1) -> TOTAL 4 exp
+    text = report_mod.format_report(store_mod.all_expenses(sample_store), month="2024-03")
+    assert "  2 exp" in text
+    assert "  1 exp" in text
+    assert "  4 exp" in text  # TOTAL row
+
+
+def test_format_report_shows_pct_of_total(sample_store):
+    # food: 92.12 / 172.82 = 53.3 %
+    text = report_mod.format_report(store_mod.all_expenses(sample_store), month="2024-03")
+    assert "53.3%" in text
+
+
+def test_format_report_shows_budget_pct_for_month(sample_store):
+    text = report_mod.format_report(store_mod.all_expenses(sample_store), month="2024-03")
+    assert "of budget" in text
+
+
+def test_format_report_no_budget_without_month(sample_store):
+    text = report_mod.format_report(store_mod.all_expenses(sample_store))
+    assert "of budget" not in text
+
+
+def test_format_report_budget_warn_marker():
+    from tally import store as store_mod2
+    data = store_mod2.empty_store()
+    store_mod2.add_expense(data, date="2024-05-01", amount=480.0, currency="USD", category="food")
+    text = report_mod.format_report(store_mod2.all_expenses(data), month="2024-05")
+    assert "(warn)" in text
+
+
+def test_format_report_budget_over_marker():
+    from tally import store as store_mod2
+    data = store_mod2.empty_store()
+    store_mod2.add_expense(data, date="2024-05-01", amount=650.0, currency="USD", category="food")
+    text = report_mod.format_report(store_mod2.all_expenses(data), month="2024-05")
+    assert "(over)" in text
+
+
