--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -81,6 +81,23 @@ def test_no_command_prints_help(capsys):
     assert "usage" in out.lower()
 
 
+def test_report_year(tmp_path, capsys):
+    store = _store_path(tmp_path)
+    cli.main(["--store", store, "add", "50", "food", "--date", "2024-03-15"])
+    cli.main(["--store", store, "add", "30", "transport", "--date", "2024-08-01"])
+    cli.main(["--store", store, "add", "20", "food", "--date", "2023-12-31"])
+    capsys.readouterr()
+    rc = cli.main(["--store", store, "report", "--year", "2024"])
+    assert rc == 0
+    out = capsys.readouterr().out
+    assert "2024" in out
+    assert "food" in out
+    assert "transport" in out
+    # The 2023 entry must not contribute to the total
+    assert "80.00" in out  # 50 + 30
+    assert "TOTAL" in out
+
+
