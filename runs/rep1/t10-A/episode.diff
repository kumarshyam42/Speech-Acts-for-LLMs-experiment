+        raise ValueError(
+            "store file {!r} contains invalid JSON: {}".format(args.store, exc)
+        ) from exc
 
 
 def cmd_add(args):
+    if args.amount <= 0:
+        raise ValueError("amount must be positive, got {}".format(args.amount))
+    if args.category not in KNOWN_CATEGORIES:
+        raise ValueError(
+            "unknown category {!r}; known: {}".format(
+                args.category, ", ".join(sorted(KNOWN_CATEGORIES))
+            )
+        )
     data = _load(args)
     # normalize the date so we fail early on a bad value
     date = parse_date(args.date).isoformat()
