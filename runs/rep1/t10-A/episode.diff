+# --- error handling ---
+
+def test_add_bad_date_returns_error(tmp_path, capsys):
+    store = _store_path(tmp_path)
+    rc = cli.main(["--store", store, "add", "10", "food", "--date", "not-a-date"])
+    assert rc == 1
+    assert "error:" in capsys.readouterr().err
+
+
+def test_add_unsupported_currency_returns_error(tmp_path, capsys):
+    store = _store_path(tmp_path)
+    rc = cli.main(["--store", store, "add", "10", "food", "--currency", "XYZ", "--date", "2024-03-01"])
+    assert rc == 1
+    assert "error:" in capsys.readouterr().err
+
+
+def test_add_negative_amount_returns_error(tmp_path, capsys):
+    store = _store_path(tmp_path)
+    rc = cli.main(["--store", store, "add", "-5", "food", "--date", "2024-03-01"])
+    assert rc == 1
+    assert "error:" in capsys.readouterr().err
+
+
+def test_add_unknown_category_returns_error(tmp_path, capsys):
+    store = _store_path(tmp_path)
+    rc = cli.main(["--store", store, "add", "10", "unicorns", "--date", "2024-03-01"])
+    assert rc == 1
+    err = capsys.readouterr().err
+    assert "error:" in err
+    assert "unicorns" in err
+
+
+def test_report_bad_month_returns_error(tmp_path, capsys):
