diff --git a/tests/test_cli.py b/tests/test_cli.py
index 7611c18..256b6c6 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -74,6 +74,34 @@ def test_list_command(tmp_path, capsys):
     assert "dinner" in out and "food" in out
 
 
+def test_report_week_filter(tmp_path, capsys):
+    store = _store_path(tmp_path)
+    # 2024-03-04 is Mon (W10), 2024-03-11 is Mon (W11)
+    cli.main(["--store", store, "add", "50", "food", "--date", "2024-03-04"])
+    cli.main(["--store", store, "add", "30", "transport", "--date", "2024-03-11"])
+    capsys.readouterr()
+    rc = cli.main(["--store", store, "report", "--week", "2024-W10"])
+    assert rc == 0
+    out = capsys.readouterr().out
+    assert "food" in out
+    assert "transport" not in out
+
+
+def test_report_week_monday_not_sunday(tmp_path, capsys):
+    store = _store_path(tmp_path)
+    # 2024-03-10 is Sun (still W10), 2024-03-11 is Mon (W11) — both must land in different weeks
+    cli.main(["--store", store, "add", "10", "food", "--date", "2024-03-10"])   # Sun W10
+    cli.main(["--store", store, "add", "20", "food", "--date", "2024-03-11"])   # Mon W11
+    capsys.readouterr()
+    out_w10 = capsys.readouterr().out
+    cli.main(["--store", store, "report", "--week", "2024-W10"])
+    out_w10 = capsys.readouterr().out
+    cli.main(["--store", store, "report", "--week", "2024-W11"])
+    out_w11 = capsys.readouterr().out
+    assert "10.00" in out_w10 and "20.00" not in out_w10
+    assert "20.00" in out_w11 and "10.00" not in out_w11
+
+
 def test_no_command_prints_help(capsys):
     rc = cli.main([])
     assert rc == 1
