     return "{:04d}-{:02d}".format(d.year, d.month)
 
 
+def week_key(d):
+    """Return the ISO week key (YYYY-Www) for a date. Weeks start on Monday (ISO 8601)."""
+    if isinstance(d, str):
+        d = parse_date(d)
+    iso = d.isocalendar()
+    return "{:04d}-W{:02d}".format(iso[0], iso[1])
+
