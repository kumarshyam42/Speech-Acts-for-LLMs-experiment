+def test_week_key_monday():
+    # 2024-03-04 is a Monday — the start of ISO week 10
+    assert utils.week_key(datetime.date(2024, 3, 4)) == "2024-W10"
+
+
+def test_week_key_sunday_same_week_as_preceding_monday():
+    # 2024-03-10 is a Sunday — still in the same week as Mon 2024-03-04 (W10)
+    assert utils.week_key(datetime.date(2024, 3, 10)) == "2024-W10"
+
+
+def test_week_key_next_monday_starts_new_week():
+    # 2024-03-11 is the following Monday — starts a new week (W11)
+    assert utils.week_key(datetime.date(2024, 3, 11)) == "2024-W11"
+
+
+def test_week_key_from_string():
+    assert utils.week_key("2024-03-04") == "2024-W10"
